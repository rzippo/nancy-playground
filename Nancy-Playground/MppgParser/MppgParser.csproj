<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <AssemblyName>Unipi.Nancy.Playground.MppgParser</AssemblyName>
        <RootNamespace>Unipi.Nancy.Playground.MppgParser</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.CLSCompliantAttribute">
            <_Parameter1>false</_Parameter1>
        </AssemblyAttribute>
        <!-- the error matchers are internal, and the tests hold them to one match per error -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Unipi.Nancy.Playground.MppgParser.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
      <Content Include="Grammar\Mppg.g4" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Antlr4.Runtime.Standard" />
      <PackageReference Include="Unipi.Nancy.Expressions" />
    </ItemGroup>

    <!-- The converted programs pin the same versions as the dependencies, read from the central catalog. -->
    <UsingTask TaskName="WritePackageVersionsConstants"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <PackageVersionItems ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
var constantByPackage = new Dictionary<string, string>();
constantByPackage.Add("Unipi.Nancy", "Nancy");
constantByPackage.Add("Unipi.Nancy.Expressions", "NancyExpressions");
constantByPackage.Add("Unipi.Nancy.Plots.ScottPlot", "ScottPlot");
constantByPackage.Add("Unipi.Nancy.Plots.Tikz", "Tikz");

var builder = new StringBuilder();
builder.AppendLine("// <auto-generated />");
builder.AppendLine("namespace Unipi.Nancy.Playground.MppgParser.Utility;");
builder.AppendLine();
builder.AppendLine("/// <summary>The dependency versions, so that converted programs pin the same packages.</summary>");
builder.AppendLine("internal static class PackageVersions");
builder.AppendLine("{");
foreach (var pair in constantByPackage)
{
    string version = null;
    foreach (var item in PackageVersionItems)
    {
        if (string.Equals(item.ItemSpec, pair.Key, StringComparison.OrdinalIgnoreCase))
        {
            version = item.GetMetadata("Version");
            break;
        }
    }
    if (string.IsNullOrEmpty(version))
    {
        Log.LogError("Package '" + pair.Key + "' has no PackageVersion in the central package catalog.");
        return false;
    }
    builder.AppendLine("    public const string " + pair.Value + " = \"" + version + "\";");
}
builder.AppendLine("}");

var content = builder.ToString();
if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != content)
    File.WriteAllText(OutputFile, content);
]]></Code>
        </Task>
    </UsingTask>

    <Target Name="GeneratePackageVersionsConstants" BeforeTargets="CoreCompile">
        <WritePackageVersionsConstants
            PackageVersionItems="@(PackageVersion)"
            OutputFile="$(IntermediateOutputPath)PackageVersions.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)PackageVersions.g.cs" />
        </ItemGroup>
    </Target>

</Project>
